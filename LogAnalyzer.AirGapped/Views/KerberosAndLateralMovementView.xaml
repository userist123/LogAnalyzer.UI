<UserControl x:Class="LogAnalyzer.UI.Views.KerberosAndLateralMovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header with Title & ADAudit Report Export Actions -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="ADAudit Intelligence &amp; Endpoint Forensics Command Center" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Margin="12,0,0,0" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="FULL ADAUDIT PLUS SUITE &amp; COMPLIANCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Auditare hibridă: Active Directory Domain, Standalone SAM, Server DNS, Conformitate (HG 585/2002, NIS2, ISO 27042), UBA &amp; LOLBAS" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📄 Export Raport ADAudit (CSV)" Command="{Binding ExportAdAuditReportCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,6"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Dual-Engine Executive KPI Ribbon (Domain & Standalone Metrics) -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <!-- Metric 1: Total AD & Local Events -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="EVENIMENTE AD / SAM" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding AdEventsAnalyzedCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="Jurnale Securitate &amp; SAM" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 2: Domain Admins Changes -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="GRUPURI PRIVILEGIATE AD" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="{Binding AdPrivilegedGroupChangesCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource DangerBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="Domain / Enterprise Admins" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 3: Standalone Local Admin Changes -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="ADMINISTRATORI LOCALI SAM" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="{Binding SamAdminGroupModificationsCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource DangerBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="BUILTIN\Administrators" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 4: Standalone USB & Media Devices -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="MEDII USB REMOVABILE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource HighBrush}"/>
                    <TextBlock Text="{Binding SamUsbStorageEventsCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource HighBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="USBSTOR / PnP Conectate" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 5: Policy & Audit Tampering -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="ALTERARE POLITICI / GPO" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="{Binding SamAuditPolicyTamperingCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="EID 4719 / 1102 / 5136" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 6: Advanced Exploits -->
            <Border Style="{StaticResource ObsidianCardStyle}" Padding="10">
                <StackPanel>
                    <TextBlock Text="ATACURI KERBEROS / AD" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="{Binding AdKerberosAttacksCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="Kerberoast, DCSync, Shadow" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. Full ADAudit Plus Multi-Workspace TabControl -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: Standalone PC & Local SAM Forensics -->
            <TabItem Header="💻 ADAudit Standalone PC &amp; SAM" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Auditare Securitate Stații Standalone &amp; Bază SAM (Grupuri Locale, USB, Politici de Audit)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding StandaloneSamFindings.Count, StringFormat='{}{0} Detecții SAM'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding StandaloneSamFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="150"/>
                                <DataGridTextColumn Header="Tip Detecție Standalone" Binding="{Binding FindingType}" Width="200"/>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="Cont / Resursă Țintă" Binding="{Binding TargetAccountOrResource}" Width="150"/>
                                <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="85"/>
                                <DataGridTextColumn Header="Proces / Dispozitiv Sursă" Binding="{Binding SourceProcessOrDevice}" Width="150"/>
                                <DataGridTextColumn Header="Descriere &amp; Acțiune Recomandată" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: Active Directory Domain & Kerberos Exploits -->
            <TabItem Header="🛡️ ADAudit Active Directory &amp; Kerberos" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Anomalii de Autentificare Domeniu, Modificări GPO, DCShadow &amp; Exploatări Replicare AD" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding KerberosFindings.Count, StringFormat='{}{0} Detecții AD'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding KerberosFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="140"/>
                                <DataGridTextColumn Header="Tip Atac / Eveniment" Binding="{Binding AttackType}" Width="180"/>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="Cont Țintă" Binding="{Binding TargetAccount}" Width="140"/>
                                <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="85"/>
                                <DataGridTextColumn Header="Sursă / IP" Binding="{Binding ClientIp}" Width="100"/>
                                <DataGridTextColumn Header="Sumar Analiză &amp; Recomandare Răspuns" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: DNS Server & Zone Auditing -->
            <TabItem Header="🌐 Audit Server DNS" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Auditare Modificări Înregistrări &amp; Zone DNS (DNS Poisoning &amp; Redirection)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding DnsFindings.Count, StringFormat='{}{0} Evenimente DNS'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DnsFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tip Detecție" Binding="{Binding FindingType}" Width="180"/>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="Nume Înregistrare" Binding="{Binding RecordName}" Width="160"/>
                                <DataGridTextColumn Header="Zonă DNS" Binding="{Binding ZoneName}" Width="150"/>
                                <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="85"/>
                                <DataGridTextColumn Header="Descriere &amp; Impact" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Acțiune Recomandată" Binding="{Binding RemediationActionRo}" Width="250"/>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: Automated Compliance Checks Matrix -->
            <TabItem Header="⚖️ Conformitate (HG 585, NIS2, ISO 27042, GDPR)" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Matrice Automată de Evaluare a Conformității de Securitate și Reglementare" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding ComplianceResults.Count, StringFormat='{}{0} Controale Evaluate'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ComplianceResults}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Standard / Cadru" Binding="{Binding Framework}" Width="170"/>
                                <DataGridTextColumn Header="Articol / Control" Binding="{Binding ArticleOrControl}" Width="140"/>
                                <DataGridTextColumn Header="Titlu Control" Binding="{Binding ControlTitle}" Width="200"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Evidență Forensică Corelată" Binding="{Binding EvidenceSummary}" Width="*"/>
                                <DataGridTextColumn Header="Măsură Corectivă Impusă" Binding="{Binding RequiredAction}" Width="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 5: User Behavior Analytics (UBA) & LOLBAS -->
            <TabItem Header="👤 UBA &amp; LOLBAS Audit" Style="{StaticResource InspectorTabItemStyle}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: UBA -->
                    <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="UBA: Anomalii Comportamentale Logon" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource EvidenceAccentBrush}"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding UbaAnomalies.Count, StringFormat='{}{0} Anomalii'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding UbaAnomalies}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Utilizator" Binding="{Binding Username}" Width="110"/>
                                    <DataGridTextColumn Header="Tip Anomalie UBA" Binding="{Binding AnomalyType}" Width="160"/>
                                    <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="80"/>
                                    <DataGridTextColumn Header="Risc" Binding="{Binding RiskWeight, StringFormat='{}{0}/100'}" Width="65"/>
                                    <DataGridTextColumn Header="Descriere" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- Right: LOLBAS -->
                    <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="Audit Execuții LOLBAS Binaries" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HighBrush}"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding LolbasFindings.Count, StringFormat='{}{0} Detecții'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding LolbasFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Binar" Binding="{Binding BinaryName}" Width="95"/>
                                    <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="75"/>
                                    <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="110"/>
                                    <DataGridTextColumn Header="Linie de Comandă" Binding="{Binding CommandLine}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
