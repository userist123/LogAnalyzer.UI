<UserControl x:Class="LogAnalyzer.UI.Views.KerberosAndLateralMovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Active Directory &amp; Lateral Movement Forensics" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Kerberoasting (T1558.003), Golden Ticket, AS-REP Roasting &amp; LOLBAS execution audit" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Main 2-Pane Split: Left Kerberos AD Anomalies, Right LOLBAS Binaries -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Kerberos Detections -->
            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="Kerberos Authentication &amp; Ticket Anomalies" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding KerberosFindings.Count, StringFormat='{}{0} Anomalies'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding KerberosFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding AttackType}" Width="160"/>
                            <DataGridTextColumn Header="Target Account" Binding="{Binding TargetAccount}" Width="130"/>
                            <DataGridTextColumn Header="Client IP" Binding="{Binding ClientIp}" Width="100"/>
                            <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="85"/>
                            <DataGridTextColumn Header="Analysis Summary" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" Margin="6,0"/>

            <!-- Right: LOLBAS Execution Audit -->
            <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="Living-off-the-Land (LOLBAS) Execution Audit" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HighBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LolbasFindings.Count, StringFormat='{}{0} Detections'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding LolbasFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Binary" Binding="{Binding BinaryName}" Width="100"/>
                            <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="85"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="Command Line" Binding="{Binding CommandLine}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>