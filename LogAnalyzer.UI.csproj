<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup Condition="Exists('..\LogAnalyzer.Core\LogAnalyzer.Core.csproj')">
    <ProjectReference Include="..\LogAnalyzer.Core\LogAnalyzer.Core.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Infrastructure\LogAnalyzer.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\LogAnalyzer.Core\LogAnalyzer.Core.csproj')">
    <ProjectReference Include="LogAnalyzer.Core\LogAnalyzer.Core.csproj" />
    <ProjectReference Include="LogAnalyzer.Infrastructure\LogAnalyzer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Categories\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LogAnalyzer.UI.Tests\**\*.cs" />
    <Page Remove="LogAnalyzer.UI.Tests\**\*.xaml" />
    <None Remove="LogAnalyzer.UI.Tests\**\*.csproj" />
  </ItemGroup>

</Project>
