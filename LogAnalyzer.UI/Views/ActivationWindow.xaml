<Window x:Class="LogAnalyzer.UI.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activare Licenta LogAnalyzer"
        Height="440" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Opacity="0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInWindowStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{StaticResource WindowBgGradient}" CornerRadius="18" Padding="2">
        <Border Style="{StaticResource GlassCard}" Margin="10">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="LogAnalyzer.MVP" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource AccentLightBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource ColorAccent}" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="Sistem neinregistrat. Este necesara o licenta valida."
                           FontSize="14" Foreground="#FFF85149"
                           HorizontalAlignment="Center" Margin="0,8,0,30"/>

                <TextBlock Text="ID HARDWARE MASINA - Copiaza si trimite furnizorului"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtHardwareId" Style="{StaticResource ModernTextBoxStyle}"
                         FontWeight="Bold" TextAlignment="Center" IsReadOnly="True" Margin="0,0,0,20"/>

                <TextBlock Text="INTRODU CHEIA DE LICENTA (20 CARACTERE)"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtLicenseKey" Style="{StaticResource ModernTextBoxStyle}"
                         FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,30"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Activeaza Produsul" Width="190" Height="42"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="ActivateClick" Margin="0,0,15,0"/>
                    <Button Content="Iesire" Width="110" Height="42"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ExitClick"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Border>
</Window>
