                                                                    <DataTemplate>
                                                                        <Border Background="#1b2336" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2">
                                                                            <TextBlock Text="{Binding}" FontSize="8.5" FontWeight="Bold" Foreground="#38bdf8"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- TAB 8: KERBEROS AD & LOLBAS AUDIT -->
                        <TabItem>
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Title -->
                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ Audit Atacuri Kerberos AD &amp; Detecție LOLBAS" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock Text="Identificarea încercărilor de Kerberoasting, AS-REP Roasting, Pass-the-Hash și a binarelor de sistem abuzate (Living-off-the-Land)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Top Grid: Kerberos Findings -->
                                <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Atacuri Active Directory / Kerberos Identificate" FontSize="12" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,10"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding KerberosFindings}" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tip Atac" Binding="{Binding AttackType}" Width="240" FontWeight="Bold" Foreground="#ef4444"/>
                                                <DataGridTextColumn Header="Tehnică MITRE" Binding="{Binding MitreTechniqueId}" Width="100"/>
                                                <DataGridTextColumn Header="Descriere &amp; Indicatori" Binding="{Binding Description}" Width="*"/>
                                                <DataGridTextColumn Header="Acțiune Containment" Binding="{Binding ContainmentActionRo}" Width="300"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- Bottom Grid: LOLBAS Findings -->
                                <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Execuții Binare LOLBAS &amp; Relații Anomale Părinte-Copil" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,10"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding LolbasFindings}" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Binar LOLBAS" Binding="{Binding BinaryName}" Width="160" FontWeight="Bold" Foreground="#00d4ff"/>
                                                <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="150"/>
                                                <DataGridTextColumn Header="Tehnică MITRE" Binding="{Binding MitreTechniqueId}" Width="100"/>
                                                <DataGridTextColumn Header="Comandă / Descriere" Binding="{Binding Description}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 9: PROVENANCE LEDGER & NIS2 COMPLIANCE -->
                        <TabItem>
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Title and Action Buttons -->
                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📜 Lanț Probatoriu de Custodie (ISO/IEC 27037) &amp; Conformitate NIS2" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ProvenanceStatusMessage}" FontSize="11" Foreground="#00ff87" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="🔍 Verifică Integritate Lanț" Command="{Binding VerifyProvenanceChainCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                                        <Button Content="⏱ Export Super-Timeline (Plaso)" Command="{Binding ExportSuperTimelineCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                                        <Button Content="📦 Export CASE/UCO 1.3" Command="{Binding ExportCaseUcoJsonCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                                        <Button Content="🔒 Sigilează Pachet Caz (.dfirbundle)" Command="{Binding SealDfirCaseBundleCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Padding="12,6" FontWeight="Bold"/>
                                        <Button Content="🚨 Draft NIS2 (24h DNSC)" Command="{Binding ExportNis2EarlyWarningCommand}" Style="{StaticResource ActionButtonStyle}" Padding="12,6" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- NIS2 Compliance Overview Box -->
                                <Border Grid.Row="1" Background="#0b1329" BorderBrush="#00d4ff" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Directiva NIS2 / OUG 155/2024 — Ceasul Obligațiilor Legale de Notificare către DNSC:" FontSize="11" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Etapa 1: Avertizare Timpurie în max. 24 de ore de la detecție. • Etapa 2: Notificare completă în max. 72 de ore. • Etapa 3: Raport final de remediere în max. 1 lună." FontSize="11" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Notificare 72h" Command="{Binding ExportNis2NotificationCommand}" Style="{StaticResource ActionButtonStyle}" Padding="10,4" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Provenance Ledger Grid -->
                                <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Jurnal de Proveniență Imutabil (Hash-Chained SHA-256 Ledger)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,10"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ProvenanceEntries}" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="50" FontWeight="Bold"/>
                                                <DataGridTextColumn Header="Data UTC" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
                                                <DataGridTextColumn Header="Acțiune Forenzică" Binding="{Binding ActionType}" Width="160" FontWeight="SemiBold" Foreground="#00d4ff"/>
                                                <DataGridTextColumn Header="Referință Probatorie" Binding="{Binding EvidenceReference}" Width="180"/>
                                                <DataGridTextColumn Header="Hash Bloc (SHA-256)" Binding="{Binding EntryHash}" Width="200" FontFamily="Consolas" FontSize="10"/>
                                                <DataGridTextColumn Header="Detalii Înregistrare" Binding="{Binding Details}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 10: MITRE ATT&CK HEATMAP & DeTT&CT MATRIX -->
                        <TabItem>
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Title and Summary Stats -->
                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🎯 Matrice Vizuală MITRE ATT&amp;CK &amp; Grad Acoperire DeTT&amp;CT" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock Text="Harta de căldură (Heatmap) a tehnicilor de atac identificate în sesiune corelate cu vizibilitatea senzorilor și a regulilor Sigma" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#0b1329" BorderBrush="#00d4ff" BorderThickness="1.5" CornerRadius="8" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ACOPERIRE VIZIBILITATE DETT&amp;CT: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MitreHeatmap.OverallVisibilityCoverage, StringFormat='{}{0}%'}" FontSize="14" FontWeight="Bold" Foreground="#00ff87" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Multi-Event Correlation Bar -->
                                <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Lanțuri de Atac Multi-Eveniment Corelate Temporal (Multi-Stage Scenarios)" FontSize="11.5" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,8"/>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding MultiEventCorrelations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0e1322" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding AttackScenario}" FontSize="11.5" FontWeight="Bold" Foreground="#ef4444"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="White" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                <Border Background="#1b2336" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding MitreTechniqueId}" FontSize="9" FontWeight="Bold" Foreground="#38bdf8"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- MITRE 12-Tactic Grid Matrix -->
                                <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding MitreTacticColumns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="165" Background="#0a0d16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="{Binding TacticName}" FontSize="10.5" FontWeight="Bold" Foreground="#00d4ff" TextAlignment="Center" TextWrapping="Wrap"/>
                                                            <Border Grid.Row="1" Height="1" Background="#1e2538" Margin="0,6,0,8"/>
                                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Techniques}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{Binding StatusColor}" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="6" ToolTip="{Binding TooltipText}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding TechniqueId}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <TextBlock Text="{Binding TechniqueName}" FontSize="9.5" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                                <TextBlock Text="{Binding DetectedCount, StringFormat='Detecții: {0}'}" FontSize="8.5" FontWeight="Bold" Foreground="#f59e0b" Visibility="{Binding IsDetected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- MODULE 1: AUDIT DATA COLLECTION -->
            <TabItem>
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Configuration panel -->
                        <ColumnDefinition Width="440"/>
                        <!-- Right: Live Console Terminal -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Configuration -->
                    <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,24,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Parametri Colectare Audit" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                                <TextBlock Text="TIP ECHIPAMENT CONECTAT:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="3,0,0,6"/>
                                <ComboBox ItemsSource="{Binding TargetTypes}" SelectedItem="{Binding SelectedTargetType}" Margin="0,0,0,18"/>

                                <TextBlock Text="HOSTNAME / ADRESĂ IP GAZDĂ:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="3,0,0,6"/>
                                <TextBox Text="{Binding CollectionHostname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                                <TextBlock Text="DIRECTOR COLECTARE LOCALĂ (DESTINAȚIE):" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="3,0,0,6"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CollectionOutputDir, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" IsReadOnly="True"/>
                                    <Button Content="Răsfoiește..." Command="{Binding SelectCollectionOutputDirCommand}" Grid.Column="1" Margin="6,0,0,0" Width="90"/>
                                </Grid>
                            </StackPanel>

                            <!-- Collector status info -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15">
                                <Border Background="#05080e" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="CONVENȚIE DENUMIRE FIȘIERE AUDIT:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="Folder Salvat:" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CollectionOutputDir, StringFormat='{}{0}\\[Luna-An]\\'}" FontSize="11" Foreground="White" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        
                                        <TextBlock Text="Folder Echipament:" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedTargetType, StringFormat='{}{}[Prefix]_{0}_[NumeHost]'}" FontSize="11" Foreground="White" Margin="0,0,0,10"/>

                                        <TextBlock Text="Nume Fișiere Redenumite:" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="[Prefix]_[NumeHost]_[NumeArtefact]_[Data].[ext]" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Run Action -->
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <Button Content="PORNEȘTE CULEGERE TELEMETRIE FORENSICĂ" Command="{Binding StartCollectionCommand}" IsEnabled="{Binding IsCollectionNotRunning}" Height="42" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Console Log terminal -->
                    <Border Grid.Column="1" Background="#05070a" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#ff3366"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCollectionRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#00ff87"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="LOG ACTIVITATE COLECTOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Grid.Row="1" Text="{Binding CollectionLogs}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="{StaticResource SuccessBrush}" BorderThickness="0" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#070a12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" VerticalAlignment="Center" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="SCUT DE SECURITATE DISPOZITIV ACTIV" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GLOBAL LOADING OVERLAY -->
        <Grid Grid.RowSpan="3" Background="#d2000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="{StaticResource PrimaryAccentBrush}" Background="#1c2028" BorderThickness="0" Margin="0,0,0,24"/>
                    <TextBlock Text="Procesare în Curs..." Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>




