<Window x:Class="LogAnalyzer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogAnalyzer.MVP - SOC &amp; DFIR Enterprise Edition" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" Background="#FF1E1E1E" Foreground="White">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF434346"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Background="#FF2D2D30" Padding="5">
            <Button Content="📁 Încarcă Folder" Command="{Binding LoadFolderCommand}"/>
            <Button Content="📄 Încarcă Fișiere" Command="{Binding LoadFilesCommand}"/>
            <Separator Margin="10,0"/>
            <Button Content="💾 Export CSV" Command="{Binding ExportToCsvCommand}"/>
            <Button Content="📄 Export Raport PDF (Parchet)" Command="{Binding ExportPdfReportCommand}" Foreground="#FF4EC9B0" FontWeight="Bold"/>
            <Separator Margin="15,0"/>
            <TextBlock Text="Profil DFIR:" VerticalAlignment="Center" Margin="5,0" Foreground="White"/>
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Width="250" VerticalAlignment="Center"/>
        </ToolBar>

        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="#FF1E1E1E" BorderBrush="#FF3F3F46" Foreground="Black">
                <TabItem Header="Jurnale EVTX" Background="#FF2D2D30">
                    <Grid Background="#FF1E1E1E">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBox Text="{Binding SearchEventsText, UpdateSourceTrigger=PropertyChanged}" Margin="5" Padding="5" Background="#FF333337" Foreground="White" BorderBrush="#FF434346" ToolTip="Caută în evenimente sau mesaj..."/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding EventsView}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="25" Background="#FF1E1E1E" AlternatingRowBackground="#FF252526" HorizontalGridLinesBrush="#FF3F3F46" VerticalGridLinesBrush="#FF3F3F46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data (UTC)" Binding="{Binding TimeCreated, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="140"/>
                                <DataGridTextColumn Header="EID" Binding="{Binding EventId}" Width="60"/>
                                <DataGridTextColumn Header="Nivel" Binding="{Binding Level}" Width="80"/>
                                <DataGridTextColumn Header="Sursă" Binding="{Binding ProviderName}" Width="150"/>
                                <DataGridTextColumn Header="Mașină" Binding="{Binding MachineName}" Width="120"/>
                                <DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenGenericDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGrid.InputBindings>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Artefacte Registri" Background="#FF2D2D30">
                    <Grid Background="#FF1E1E1E">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBox Text="{Binding SearchArtifactsText, UpdateSourceTrigger=PropertyChanged}" Margin="5" Padding="5" Background="#FF333337" Foreground="White" BorderBrush="#FF434346"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ArtifactsView}" SelectedItem="{Binding SelectedArtifact}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="25" Background="#FF1E1E1E" AlternatingRowBackground="#FF252526" HorizontalGridLinesBrush="#FF3F3F46" VerticalGridLinesBrush="#FF3F3F46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cale Cheie" Binding="{Binding KeyPath}" Width="300"/>
                                <DataGridTextColumn Header="Valoare" Binding="{Binding ValueName}" Width="150"/>
                                <DataGridTextColumn Header="Conținut" Binding="{Binding ValueData}" Width="*"/>
                            </DataGrid.Columns>
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenGenericDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGrid.InputBindings>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Timeline" Background="#FF2D2D30">
                    <DataGrid ItemsSource="{Binding TimelineView}" SelectedItem="{Binding SelectedTimelineItem}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="25" Background="#FF1E1E1E" AlternatingRowBackground="#FF252526" HorizontalGridLinesBrush="#FF3F3F46" VerticalGridLinesBrush="#FF3F3F46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="140"/>
                            <DataGridTextColumn Header="Sursă" Binding="{Binding Source}" Width="100"/>
                            <DataGridTextColumn Header="Categorie / Tip" Binding="{Binding Category}" Width="200"/>
                            <DataGridTextColumn Header="Descriere" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenGenericDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataGrid.InputBindings>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#FF2D2D30" Margin="2,0"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Alerte Securitate" Foreground="#FFD69D36" BorderBrush="#FF434346">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <CheckBox Content="Ascunde alerte verificate" IsChecked="{Binding HideVerifiedAlerts}" Foreground="White" Margin="5"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="25" Background="#FF1E1E1E" AlternatingRowBackground="#FF252526" HorizontalGridLinesBrush="#FF3F3F46" VerticalGridLinesBrush="#FF3F3F46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sev" Binding="{Binding Severity}" Width="60"/>
                                <DataGridTextColumn Header="Alertă" Binding="{Binding Title}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#FF2D2D30" Margin="0,2"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="Inspector Detalii Brute" Foreground="White" BorderBrush="#FF434346" Margin="0,0,0,5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding InspectorMachineName, StringFormat='Host / Sursă: {0}'}" FontWeight="Bold" Margin="0,0,0,3" Foreground="#FF4EC9B0"/>
                                <TextBlock Text="{Binding InspectorProviderName, StringFormat='Provider: {0}'}" Margin="0,0,0,3" Foreground="LightGray"/>
                                <TextBlock Text="{Binding InspectorTimeCreated, StringFormat='Timp: {0}'}" Margin="0,0,0,5" Foreground="LightGray"/>
                                <TextBox Text="{Binding InspectorMessage}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="12" AcceptsReturn="True"/>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="IOC-uri Detectate (Click pivotare)" Foreground="White" BorderBrush="#FF434346">
                        <ListBox ItemsSource="{Binding CurrentIocs}" Background="#FF1E1E1E" BorderThickness="0" Foreground="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="{Binding Type}" FontWeight="Bold" Width="50" Foreground="#FF4EC9B0"/>
                                        <TextBlock Text="{Binding Value}" Cursor="Hand" Foreground="#FF569CD6" TextDecorations="Underline">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotIocCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Value}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Background="#FF007ACC" Foreground="White">
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="5,0,0,0"/>
        </StatusBar>

        <Grid Grid.RowSpan="3" Background="#B2000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="300" Height="25" Margin="0,0,0,15"/>
                <TextBlock Text="Se procesează..." Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>