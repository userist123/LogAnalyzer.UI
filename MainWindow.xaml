                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Row 1: Search Text & Presets -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Search Text -->
                                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBox Text="{Binding SearchEventsText, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" ToolTip="Căutare rapidă în timeline..." />
                                                </Grid>
                                                
                                                <!-- Timeframe Preset -->
                                                <ComboBox Grid.Column="1" Margin="0,0,6,0" SelectedValue="{Binding FilterTimeframePreset}" SelectedValuePath="Content">
                                                    <ComboBoxItem IsSelected="True">Toate</ComboBoxItem>
                                                    <ComboBoxItem>Ultima zi</ComboBoxItem>
                                                    <ComboBoxItem>Ultimele 7 zile</ComboBoxItem>
                                                </ComboBox>
                                                
                                                <!-- Event ID text filter -->
                                                <TextBox Grid.Column="2" Text="{Binding FilterEventId, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" ToolTip="Filtrare după ID-uri Evenimente specifice (ex: 4624, 4625)"/>
                                            </Grid>
                                            
                                            <!-- Row 2: Quick Toggles (Severity, Use Cases) -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Severity Badges Checklist -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Severitate:" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                                    <CheckBox IsChecked="{Binding FilterCritical}" Content="Critic" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                    <CheckBox IsChecked="{Binding FilterHigh}" Content="Ridicata" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                    <CheckBox IsChecked="{Binding FilterMedium}" Content="Medie" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                    <CheckBox IsChecked="{Binding FilterInfo}" Content="Info" Foreground="{StaticResource SuccessBrush}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <!-- Quick Use Cases -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Filtre SOC Rapide:" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                                    <CheckBox IsChecked="{Binding FilterFailedLogins}" Content="Autentificări Eșuate (4625)" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                    <CheckBox IsChecked="{Binding FilterPrivEsc}" Content="Modificări Cont/Grup (4720/4732)" FontSize="11" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding TimelineItems}" SelectedItem="{Binding SelectedTimelineItem}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Timestamp Eveniment" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
                                            <DataGridTextColumn Header="Sursă" Binding="{Binding Source}" Width="90"/>
                                            <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="150"/>
                                            <DataGridTextColumn Header="Utilizator / Host" Binding="{Binding UserOrHost}" Width="130"/>
                                            <DataGridTextColumn Header="Mesaj Detaliat Eveniment" Binding="{Binding Description}" Width="*"/>
                                        </DataGrid.Columns>
                                        <DataGrid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenGenericDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        </DataGrid.InputBindings>
                                    </DataGrid>
                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Afișare paginată: 100 rânduri / pagină" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="◀ Precedenta" Command="{Binding PrevTimelinePageCommand}" Width="90" Margin="2,0"/>
                                            <TextBlock Text="{Binding TimelineCurrentPage}" VerticalAlignment="Center" Foreground="White" Margin="10,0" FontWeight="Bold"/>
                                            <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TimelineTotalPages}" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                                            <Button Content="Următoarea ▶" Command="{Binding NextTimelinePageCommand}" Width="90" Margin="2,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#1e2538" Margin="8,0"/>

                                <TabControl Grid.Column="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TabItem">
                                                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                        </Style>
                                    </TabControl.Resources>
                                    
                                    <!-- Tab 1: Properties -->
                                    <TabItem Header="Proprietăți Parsate">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="PROPRIETĂȚI CRONOLOGICE EVENIMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,8"/>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedEventProperties}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Proprietate" Binding="{Binding Key}" Width="130" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <DataGridTextColumn Header="Valoare" Binding="{Binding Value}" Width="*" Foreground="White"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>

                                    <!-- Tab 2: Security Assessment -->
                                    <TabItem Header="Analiză Securitate">
                                        <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="EVALUARE AMENINȚĂRI SOC" FontSize="11" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,10"/>
                                                
                                                <!-- Mitre Mapping Section -->
                                                <Border Margin="0,0,0,10" Padding="8" CornerRadius="4" Background="#1c1f30" BorderBrush="Orange" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Mapare MITRE ATT&amp;CK:" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SelectedEventMitreMapping}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <!-- Scenario Description -->
                                                <TextBlock Text="Scenariu Amenințare:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SelectedEventThreatScenario}" TextWrapping="Wrap" FontSize="11" Foreground="White" Margin="0,0,0,12"/>
                                                
                                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                                                
                                                <!-- Action Playbook -->
                                                <TextBlock Text="Recomandări Containment &amp; Playbook:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding SelectedEventMitigation}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Segoe UI" FontSize="11.5" AcceptsReturn="True"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- Tab 3: Description -->
                                    <TabItem Header="Mesaj Complet">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="DESCRIERE DETALIATĂ / METADATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,8"/>
                                            <TextBox Grid.Row="1" Text="{Binding InspectorMessage}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="11.5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>

                        <!-- TAB 5: AI & EXPLAINABLE RISK ANALYSIS -->
