                                                    <DataTemplate>
                                                        <Border Background="#0e1322" BorderBrush="{Binding SeverityColor}" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,10" Padding="14" Cursor="Hand" ToolTip="Click pentru filtrare investigație pe acest stadiu">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotStorylineStageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding StageIcon}" FontSize="24" HorizontalAlignment="Center"/>
                                                                    <Border Background="#1b2336" CornerRadius="4" Padding="6,2" Margin="0,6,0,0">
                                                                        <TextBlock Text="{Binding TechniqueId}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StageName}" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SeverityColor}" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                                                                    <TextBlock Text="{Binding ConfidenceScore, StringFormat='Încredere: {0}%'}" FontSize="10" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Right"/>
                                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 7: APT THREAT ACTOR ATTRIBUTION -->
                        <TabItem>
                            <Grid Margin="24">
