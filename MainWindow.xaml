<Window x:Class="LogAnalyzer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LogAnalyzer.UI.ViewModels"
        Title="LogAnalyzer Enterprise - Threat Triage &amp; Incident Response Command Center" Height="850" Width="1450"
        WindowStartupLocation="CenterScreen" Background="#070812" Foreground="#a7adc2">

    <Window.Resources>
        <!-- Premium Visual DNA - Electric Violet & Deep Navy Theme Palette -->
        <SolidColorBrush x:Key="BgBrush" Color="#070812"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0c0f1c"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#111528"/>
        <SolidColorBrush x:Key="Surface3Brush" Color="#151a31"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1b2035"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#8b5cf6"/>
        <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#4f46e5"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#ef4444"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#f59e0b"/>
        
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f5f7ff"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#a7adc2"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6f758b"/>
        
        <!-- Button Style (Rounded, Subtle Gradient, Professional Accent) -->
        <Style TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#151a31" Offset="0"/>
                        <GradientStop Color="#0c0f1c" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1a2035" Offset="0"/>
                                            <GradientStop Color="#111528" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style (Electric Violet Gradient) -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7c3aed"/>
                    <Setter Property="BorderBrush" Value="#7c3aed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action Button Style (Subtle Dark Slate with Cyan Border) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#131b2e"/>
            <Setter Property="Foreground" Value="#38bdf8"/>
            <Setter Property="BorderBrush" Value="#2563eb"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1e293b"/>
                    <Setter Property="BorderBrush" Value="#38bdf8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Universal Dark High-Contrast TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0c1020"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#22304c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="#a78bfa"/>
            <Setter Property="SelectionBrush" Value="#7c3aed"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38bdf8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8b5cf6"/>
                                <Setter TargetName="border" Property="Background" Value="#11172e"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#080b16"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1b2035"/>
                                <Setter Property="Foreground" Value="#cbd5e1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="5" Background="#0c1020" BorderBrush="#22304c" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#38bdf8" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#38bdf8"/>
                    <Setter TargetName="Border" Property="Background" Value="#11172e"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#8b5cf6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Custom Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0c1020"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="#38bdf8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2e1065"/>
                                <Setter Property="Foreground" Value="#c4b5fd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Complete Custom Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="Background" Value="#0c1020"/>
            <Setter Property="BorderBrush" Value="#22304c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="#f8fafc" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0c1020" BorderThickness="1" BorderBrush="#38bdf8" CornerRadius="4" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Universal Dark High-Contrast CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#0c1020"/>
            <Setter Property="BorderBrush" Value="#22304c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Grid.Column="0" Width="16" Height="16" CornerRadius="3"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3 8 L 6 11 L 12 4" Stroke="#38bdf8" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#17243c"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#38bdf8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#38bdf8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Density Professional DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>
        
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Top Header Navigation Tabs -->
        <Style x:Key="HeaderTabStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTab0Style" TargetType="RadioButton" BasedOn="{StaticResource HeaderTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedModuleIndex}" Value="0">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderTab1Style" TargetType="RadioButton" BasedOn="{StaticResource HeaderTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedModuleIndex}" Value="1">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Navigation Buttons -->
        <Style x:Key="SidebarTabStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid>
                                <Rectangle x:Name="AccentBar" Width="3.5" HorizontalAlignment="Left" Fill="{StaticResource PrimaryAccentBrush}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="15,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTab0Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab1Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab2Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab3Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab4Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab5Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab6Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="6">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab7Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="7">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab8Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="8">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab9Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="9">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab10Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="10">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Glassmorphic card styling -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#111528" Opacity="0.85"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="3" Opacity="0.4" BlurRadius="12"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ScrollBar Styling (Cyber Theme) -->
        <Style x:Key="CyberScrollbarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="5" Background="#2c374d" Opacity="0.7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable ScrollBar Track Button Style -->
        <Style x:Key="ScrollBarTrackButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical ScrollBar Template with Page Commands -->
        <ControlTemplate x:Key="ScrollBarVerticalTemplate" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Border CornerRadius="5" Background="#111528" Opacity="0.4" Grid.Row="0" Grid.Column="0"/>
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource CyberScrollbarThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Horizontal ScrollBar Template with Page Commands -->
        <ControlTemplate x:Key="ScrollBarHorizontalTemplate" TargetType="ScrollBar">
            <Grid Background="Transparent">
                <Border CornerRadius="5" Background="#111528" Opacity="0.4" Grid.Row="0" Grid.Column="0"/>
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource CyberScrollbarThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="CyberScrollbar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template" Value="{StaticResource ScrollBarVerticalTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource ScrollBarHorizontalTemplate}"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource CyberScrollbar}"/>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="56"/>
            <!-- Content Work Area -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="#070a12" BorderThickness="0,0,0,1" BorderBrush="#121622" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ LOGANALYZER" FontWeight="Black" FontSize="16" Foreground="White"/>
                    <Border Margin="12,0" Width="1.5" Height="16" Background="#1e2538"/>
                    <TextBlock Text="COMMAND CENTER v2.5" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Module Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <RadioButton Content="ANALIZĂ FORENZICĂ" Style="{StaticResource HeaderTab0Style}" Command="{Binding SwitchModuleCommand}" CommandParameter="0"/>
                    <RadioButton Content="COLECTARE DATE AUDIT" Style="{StaticResource HeaderTab1Style}" Command="{Binding SwitchModuleCommand}" CommandParameter="1"/>
                </StackPanel>

                <!-- Telemetry & Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="OPERATOR:" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OperatorName}" FontSize="10" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="DB CACHE:" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DatabaseSize}" FontSize="10" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="LICENȚĂ:" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LicenseTier}" FontSize="10" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="NOD DE COMANDA ONLINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WORKSPACE (Bound to SelectedModuleIndex) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedModuleIndex}" BorderThickness="0" Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- MODULE 0: FORENSIC ANALYSIS -->
            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left Sidebar (Navigation & Controls) -->
                        <ColumnDefinition Width="240"/>
                        <!-- Main Content View -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar -->
                    <Grid Grid.Column="0" Background="#070a12" Margin="0,0,1,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Profile Selection -->
                        <StackPanel Grid.Row="0" Margin="18,18,18,12">
                            <TextBlock Text="PROFIL FILTRARE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="3,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/>
                        </StackPanel>

                        <!-- Navigation Items (Scrollable for perfect fit on any resolution) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="6,2">
                            <StackPanel Margin="4,2">
                                <RadioButton Content="📊 Command Dashboard" Style="{StaticResource SidebarTab0Style}" Command="{Binding NavigateCommand}" CommandParameter="0"/>
                                <RadioButton Content="📁 Jurnale EVTX Windows" Style="{StaticResource SidebarTab1Style}" Command="{Binding NavigateCommand}" CommandParameter="1"/>
                                <RadioButton Content="🔑 Registru Offline" Style="{StaticResource SidebarTab2Style}" Command="{Binding NavigateCommand}" CommandParameter="2"/>
                                <RadioButton Content="🚨 Alerte Securitate" Style="{StaticResource SidebarTab3Style}" Command="{Binding NavigateCommand}" CommandParameter="3"/>
                                <RadioButton Content="⏱ Cronologie Incident" Style="{StaticResource SidebarTab4Style}" Command="{Binding NavigateCommand}" CommandParameter="4"/>
                                <RadioButton Content="🧠 Analiză AI &amp; Euristică" Style="{StaticResource SidebarTab5Style}" Command="{Binding NavigateCommand}" CommandParameter="5"/>
                                <RadioButton Content="🗺️ Narativă Atac &amp; Kill Chain" Style="{StaticResource SidebarTab6Style}" Command="{Binding NavigateCommand}" CommandParameter="6"/>
                                <RadioButton Content="🕵️ Profil Grupare APT &amp; CTI" Style="{StaticResource SidebarTab7Style}" Command="{Binding NavigateCommand}" CommandParameter="7"/>
                                <RadioButton Content="🛡️ Kerberos AD &amp; LOLBAS" Style="{StaticResource SidebarTab8Style}" Command="{Binding NavigateCommand}" CommandParameter="8"/>
                                <RadioButton Content="📜 Lanț Custodie &amp; NIS2" Style="{StaticResource SidebarTab9Style}" Command="{Binding NavigateCommand}" CommandParameter="9"/>
                                <RadioButton Content="🎯 Matrice MITRE &amp; DeTT&amp;CT" Style="{StaticResource SidebarTab10Style}" Command="{Binding NavigateCommand}" CommandParameter="10"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Group -->
                        <StackPanel Grid.Row="2" Margin="18">
                            <Button Content="📁 Încarcă Folder Triage" Command="{Binding LoadFolderCommand}" Margin="0,3"/>
                            <Button Content="📄 Încarcă Fișiere Log" Command="{Binding LoadFilesCommand}" Margin="0,3"/>
                            <Button Content="📤 Exportă Raport CSV" Command="{Binding ExportCsvCommand}" Margin="0,3" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="📂 Deschide Folder Audit" Command="{Binding OpenAuditFolderCommand}" Margin="0,3"/>
                            <Button Content="⚠️ Reset / Ștergere Cache" Command="{Binding ClearCacheCommand}" Margin="0,8,0,3" BorderBrush="{StaticResource DangerBrush}" Foreground="{StaticResource DangerBrush}" Background="Transparent">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2d1316"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Main Tab Content Area (Bound to SelectedTabIndex) -->
                    <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <!-- TAB 0: DASHBOARD -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" Text="Tablou de Comandă - Monitorizare Incidente" FontSize="18" FontWeight="Bold" Margin="8,0,0,18" Foreground="White"/>

                                    <!-- Glowing KPI Cards (Rounded, Gradient Borders, Minimalist Layout) -->
                                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                                        <!-- Card 1 -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="LOGURI EVENIMENTE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="🖥️" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding TotalEventsCount, FallbackValue=0}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="28" FontWeight="Bold"/>
                                                <TextBlock Text="Înregistrate în SQLite DB" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Card 2 -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="ALERTE CORELARE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="🚨" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding TotalAlertsCount, FallbackValue=0}" Foreground="{StaticResource DangerBrush}" FontSize="28" FontWeight="Bold"/>
                                                <TextBlock Text="Indicatori critici detectați" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Card 3 -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="ARTEFACTE REGISTRU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="🔑" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding TotalRegistryCount, FallbackValue=0}" Foreground="{StaticResource SuccessBrush}" FontSize="28" FontWeight="Bold"/>
                                                <TextBlock Text="Chei offline analizate din Hive" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Card 4 -->
                                        <Border Style="{StaticResource GlassCardStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="MAȘINI IDENTIFICATE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                                    <TextBlock Text="🌐" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding TotalHostsCount, FallbackValue=0}" Foreground="{StaticResource WarningBrush}" FontSize="28" FontWeight="Bold"/>
                                                <TextBlock Text="Noduri unice diagnosticate" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                      <!-- Middle Split: Active Alerts Grid & Matrix Heatmap -->
                                    <Grid Grid.Row="2" Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Alerts DataGrid Panel -->
                                        <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,18,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Alerte de Securitate Corelate (Jurnal Amenințări)" FontSize="14" FontWeight="Bold" Margin="3,0,0,12" Foreground="White"/>
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="80"/>
                                                        <DataGridTextColumn Header="Tehnică" Binding="{Binding MitreTechniqueId}" Width="80"/>
                                                        <DataGridTextColumn Header="Tip Alertă" Binding="{Binding Title}" Width="160"/>
                                                        <DataGridTextColumn Header="Descriere Analiză Forenzică" Binding="{Binding Explanation}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>

                                        <!-- Dynamic MITRE ATT&CK Matrix Heatmap Widget (Structured Grid) -->
                                        <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Matricea de Corelare Tactică MITRE ATT&amp;CK" FontSize="13" FontWeight="Bold" Margin="3,0,0,12" Foreground="White"/>
                                                
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Column 1: Access & Exec -->
                                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="2,0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="ACCES / EXECUȚIE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding AccessExecTechniques}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{Binding DetectionColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1.5" CornerRadius="4" Height="50" Margin="2" Padding="4" Cursor="Hand" ToolTip="Click pentru filtrare investigație pe această tehnică">
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotMitreTechniqueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                                </Border.InputBindings>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding TechId}" FontWeight="Bold" FontSize="9.5" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Name}" FontSize="8" Foreground="LightGray" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Column 2: Persistence & PrivEsc -->
                                                    <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="2,0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="PERSISTENȚĂ / PRIVILEGII" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding PersistencePrivEscTechniques}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{Binding DetectionColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1.5" CornerRadius="4" Height="50" Margin="2" Padding="4" Cursor="Hand" ToolTip="Click pentru filtrare investigație pe această tehnică">
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotMitreTechniqueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                                </Border.InputBindings>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding TechId}" FontWeight="Bold" FontSize="9.5" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Name}" FontSize="8" Foreground="LightGray" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Column 3: Defense Evasion -->
                                                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="2,0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="EVAZIUNE APĂRARE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding DefenseEvasionTechniques}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{Binding DetectionColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1.5" CornerRadius="4" Height="50" Margin="2" Padding="4" Cursor="Hand" ToolTip="Click pentru filtrare investigație pe această tehnică">
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotMitreTechniqueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                                </Border.InputBindings>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding TechId}" FontWeight="Bold" FontSize="9.5" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Name}" FontSize="8" Foreground="LightGray" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Column 4: Credential Access -->
                                                    <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="2,0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="ACCES CREDENȚIALE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding CredentialAccessTechniques}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{Binding DetectionColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1.5" CornerRadius="4" Height="50" Margin="2" Padding="4" Cursor="Hand" ToolTip="Click pentru filtrare investigație pe această tehnică">
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotMitreTechniqueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                                </Border.InputBindings>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding TechId}" FontWeight="Bold" FontSize="9.5" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Name}" FontSize="8" Foreground="LightGray" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Column 5: Impact -->
                                                    <Border Grid.Column="4" Margin="2,0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="IMPACT / AFECTARE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding ImpactTechniques}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{Binding DetectionColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1.5" CornerRadius="4" Height="50" Margin="2" Padding="4" Cursor="Hand" ToolTip="Click pentru filtrare investigație pe această tehnică">
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotMitreTechniqueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                                </Border.InputBindings>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding TechId}" FontWeight="Bold" FontSize="9.5" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Name}" FontSize="8" Foreground="LightGray" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 1: EVTX LOGS -->
                        <TabItem>
                            <Grid Margin="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="380"/>
                                </Grid.ColumnDefinitions>

                                <!-- Table & Search & Process Tree -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="250"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="200" MinHeight="100"/>
                                    </Grid.RowDefinitions>
                                    <!-- Forensic Filter Console Panel -->
                                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="8" CornerRadius="6" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Row 1: Search Text & Presets -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Search Text -->
                                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBox Text="{Binding SearchEventsText, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" ToolTip="Căutare după EID, Sursă sau Mesaj..." />
                                                </Grid>
                                                
                                                <!-- Timeframe Preset -->
                                                <ComboBox Grid.Column="1" Margin="0,0,6,0" SelectedValue="{Binding FilterTimeframePreset}" SelectedValuePath="Content">
                                                    <ComboBoxItem IsSelected="True">Toate</ComboBoxItem>
                                                    <ComboBoxItem>Ultima zi</ComboBoxItem>
                                                    <ComboBoxItem>Ultimele 7 zile</ComboBoxItem>
                                                </ComboBox>
                                                
                                                <!-- Event ID text filter -->
                                                <TextBox Grid.Column="2" Text="{Binding FilterEventId, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" ToolTip="Filtrare după ID-uri Evenimente specifice (ex: 4624, 4625)"/>
                                            </Grid>
                                            
                                            <!-- Row 2: Quick Toggles (Severity, Use Cases) -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Severity Badges Checklist -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Severitate:" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                                    <CheckBox IsChecked="{Binding FilterCritical}" Content="Critic" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                    <CheckBox IsChecked="{Binding FilterHigh}" Content="Ridicată" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                    <CheckBox IsChecked="{Binding FilterMedium}" Content="Medie" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                    <CheckBox IsChecked="{Binding FilterInfo}" Content="Info" Foreground="{StaticResource SuccessBrush}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                
