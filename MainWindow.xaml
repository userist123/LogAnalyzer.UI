                                                        </Grid>
                                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Origin, StringFormat='Origine: {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#00d4ff"/>
                                                            <TextBlock Text="{Binding TargetSectors, StringFormat='Ținte: {0}'}" FontSize="10" Foreground="#e1e7f0" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
