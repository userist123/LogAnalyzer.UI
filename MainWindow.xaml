                                            <TextBlock Text="{Binding AiHighEntropyCount}" Foreground="#f59e0b" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock Text="Scripturi/Comenzi Obfuscate" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="PROCESS MASQUERADING" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding AiMasqueradingCount}" Foreground="#ef4444" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock Text="Execuție din Directoare Temp" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCardStyle}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SEMNĂTURI YARA &amp; OFF-HOURS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding AiYaraMatchesCount}" Foreground="#38bdf8" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock Text="Potriviri Tipar Malițios" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Executive Summary Box -->
                                <Border Grid.Row="2" Background="#0b1329" BorderBrush="#00d4ff" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Sinteză Executivă &amp; Recomandări Tactice:" FontSize="11" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding AiExecutiveSummary}" FontSize="11.5" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Explainable Risk Factors Table -->
                                <Border Grid.Row="3" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Descompunerea Factorilor de Risc Ponderați (ISO/IEC 27042 Audit Trail)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,10"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ExplainableRiskFactors}" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Puncte" Binding="{Binding WeightPoints, StringFormat='+{0} pct'}" Width="80" FontWeight="Bold" Foreground="#ef4444"/>
                                                <DataGridTextColumn Header="Categorie Risc" Binding="{Binding Category}" Width="180" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Tehnică MITRE" Binding="{Binding MitreTechniqueId}" Width="100"/>
                                                <DataGridTextColumn Header="Sursă Probatorie" Binding="{Binding EvidenceSource}" Width="140"/>
                                                <DataGridTextColumn Header="Justificare Legală / Descriere" Binding="{Binding LegalJustification}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 6: ATTACK STORYLINE & KILL CHAIN -->
                        <TabItem>
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Title -->
                                <Grid Grid.Row="0" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗺️ Narativă de Atac &amp; Cyber Kill Chain Lineage" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,12,0"/>
                                            <Border Background="#2d1217" BorderBrush="#ef4444" BorderThickness="1.5" CornerRadius="12" Padding="10,2">
                                                <TextBlock Text="{Binding CurrentStoryline.RiskLevel, StringFormat='SEVERITATE: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#ef4444"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Reconstrucție automată a vectorului de intruziune de la accesul inițial până la impactul final" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📑 Exportă Raport Incident PDF" Command="{Binding ExportPdfReportCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8" FontWeight="Bold"/>
                                </Grid>

                                <!-- Summary Box -->
                                <Border Grid.Row="1" Background="#0b1329" BorderBrush="#00d4ff" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentStoryline.IncidentTitle}" FontSize="13" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding CurrentStoryline.OverallSummary}" FontSize="11.5" LineHeight="17" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Kill Chain Stages -->
                                <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
