<Window x:Class="LogAnalyzer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogAnalyzer Enterprise - Security Audit &amp; Forensic Analysis" Height="850" Width="1450"
        WindowStartupLocation="CenterScreen" Background="#0b0c0e" Foreground="White">

    <Window.Resources>
        <!-- Sober & Flat Styling System (CrowdStrike / Splunk / Sentinel Style) -->
        
        <!-- Button Style (Flat, Sharp Corners) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1c2028"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2c3345"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#272f3d"/>
                                <Setter Property="BorderBrush" Value="#3d495c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00adb5"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11141a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#232731"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00adb5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#11141a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#232731"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- High-Density DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0b0c0e"/>
            <Setter Property="RowBackground" Value="#11141a"/>
            <Setter Property="AlternatingRowBackground" Value="#14171d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeight" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#14171d"/>
            <Setter Property="Foreground" Value="#9fa6b2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#232731"/>
        </Style>
        
        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22262f"/>
                    <Setter Property="Foreground" Value="#00adb5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Top Header Navigation Tabs -->
        <Style x:Key="HeaderTabStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#14171d"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#00adb5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#11141a"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTab0Style" TargetType="RadioButton" BasedOn="{StaticResource HeaderTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedModuleIndex}" Value="0">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderTab1Style" TargetType="RadioButton" BasedOn="{StaticResource HeaderTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedModuleIndex}" Value="1">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar RadioButtons Styled as Navigation Tabs -->
        <Style x:Key="SidebarTabStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <Grid>
                                <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left" Fill="#00adb5" Visibility="Collapsed"/>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#1c2028"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14171d"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTab0Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab1Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab2Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab3Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarTab4Style" TargetType="RadioButton" BasedOn="{StaticResource SidebarTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Workspace Switcher Bar -->
            <RowDefinition Height="50"/>
            <!-- Active Module Work Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- TOP SWITCHER HEADER -->
        <Border Grid.Row="0" Background="#11141a" BorderThickness="0,0,0,1" BorderBrush="#232731" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo (Sober) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LOGANALYZER" FontWeight="Black" FontSize="15" Foreground="White"/>
                    <Border Margin="10,0" Width="1" Height="15" Background="#232731"/>
                    <TextBlock Text="ENTERPRISE EDITION" FontSize="10" FontWeight="Bold" Foreground="#00adb5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Session Switcher Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <RadioButton Content="🛡️ ANALIZĂ FORENZICĂ" Style="{StaticResource HeaderTab0Style}" Command="{Binding SwitchModuleCommand}" CommandParameter="0"/>
                    <RadioButton Content="📥 COLECTARE DATE AUDIT" Style="{StaticResource HeaderTab1Style}" Command="{Binding SwitchModuleCommand}" CommandParameter="1"/>
                </StackPanel>

                <!-- System attestation tag -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1b2028" BorderBrush="#2c3345" BorderThickness="1" CornerRadius="2" Padding="8,4">
                        <TextBlock Text="INVESTIGATOR SECURE SESSION" FontSize="10" FontWeight="Bold" Foreground="LightGray"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WORKSPACE (Tabs with hidden headers, bound to SelectedModuleIndex) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedModuleIndex}" BorderThickness="0" Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- MODULE 0: FORENSIC ANALYSIS -->
            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left Sidebar (Forensics) -->
                        <ColumnDefinition Width="230"/>
                        <!-- Forensics Page Workspace -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar -->
                    <Grid Grid.Column="0" Background="#11141a" Margin="0,0,1,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Profile Selection -->
                        <StackPanel Grid.Row="0" Margin="15,15,15,10">
                            <TextBlock Text="PROFIL FILTRARE DFIR:" FontSize="9" FontWeight="Bold" Foreground="#9fa6b2" Margin="3,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/>
                        </StackPanel>

                        <!-- Sidebar Links -->
                        <StackPanel Grid.Row="1" Margin="8,10">
                            <RadioButton Content="📊 Overview Dashboard" Style="{StaticResource SidebarTab0Style}" Command="{Binding NavigateCommand}" CommandParameter="0"/>
                            <RadioButton Content="📁 Jurnale EVTX" Style="{StaticResource SidebarTab1Style}" Command="{Binding NavigateCommand}" CommandParameter="1"/>
                            <RadioButton Content="🔑 Registru Offline" Style="{StaticResource SidebarTab2Style}" Command="{Binding NavigateCommand}" CommandParameter="2"/>
                            <RadioButton Content="🚨 Alerte Securitate" Style="{StaticResource SidebarTab3Style}" Command="{Binding NavigateCommand}" CommandParameter="3"/>
                            <RadioButton Content="⏱ Timeline Incident" Style="{StaticResource SidebarTab4Style}" Command="{Binding NavigateCommand}" CommandParameter="4"/>
                        </StackPanel>

                        <!-- Forensic Core Actions -->
                        <StackPanel Grid.Row="2" Margin="15">
                            <Button Content="📁 Încarcă Folder Audit" Command="{Binding LoadFolderCommand}" Margin="0,2"/>
                            <Button Content="📄 Încarcă Fișiere" Command="{Binding LoadFilesCommand}" Margin="0,2"/>
                        </StackPanel>
                    </Grid>

                    <!-- Forensics Tab Workspace (Bound to SelectedTabIndex) -->
                    <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <!-- TAB 0: DASHBOARD -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" Text="Overview Dashboard - Forensic Analysis Session" FontSize="16" FontWeight="Bold" Margin="10,0,0,15" Foreground="LightGray"/>

                                    <!-- Flat KPI Cards (No glowing glows, purely professional) -->
                                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                                        <Border Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15" Margin="8">
                                            <StackPanel>
                                                <TextBlock Text="LOGURI EVENIMENTE" Foreground="#9fa6b2" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding TotalEventsCount, FallbackValue=0}" Foreground="#00adb5" FontSize="26" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15" Margin="8">
                                            <StackPanel>
                                                <TextBlock Text="ALERTE CORELARE" Foreground="#9fa6b2" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding TotalAlertsCount, FallbackValue=0}" Foreground="#ef4444" FontSize="26" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15" Margin="8">
                                            <StackPanel>
                                                <TextBlock Text="ARTEFACTE REGISTRU" Foreground="#9fa6b2" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding TotalRegistryCount, FallbackValue=0}" Foreground="#10b981" FontSize="26" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15" Margin="8">
                                            <StackPanel>
                                                <TextBlock Text="HOSTURI IDENTIFICATE" Foreground="#9fa6b2" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding TotalHostsCount, FallbackValue=0}" Foreground="#f59e0b" FontSize="26" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Bottom Grid Split -->
                                    <Grid Grid.Row="2" Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="380"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Alerts -->
                                        <Border Grid.Column="0" Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15" Margin="0,0,15,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Alerte Securitate Active" FontSize="13" FontWeight="Bold" Margin="3,0,0,10" Foreground="LightGray"/>
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Sev" Binding="{Binding Severity}" Width="60"/>
                                                        <DataGridTextColumn Header="Alertă" Binding="{Binding Title}" Width="200"/>
                                                        <DataGridTextColumn Header="Descriere Analiză" Binding="{Binding Explanation}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Border>

                                        <!-- Session info -->
                                        <Border Grid.Column="1" Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="Detalii Conexiune Audit" FontSize="13" FontWeight="Bold" Margin="3,0,0,12" Foreground="LightGray"/>
                                                
                                                <TextBlock Text="Engine Stocare:" FontSize="9" FontWeight="Bold" Foreground="#9fa6b2" Margin="3,4,0,1"/>
                                                <TextBlock Text="SQLite Database Engine (LogAnalyzer.db)" FontSize="11" Foreground="White" Margin="3,0,0,8"/>

                                                <TextBlock Text="Stare Tranzacții:" FontSize="9" FontWeight="Bold" Foreground="#9fa6b2" Margin="3,0,0,1"/>
                                                <TextBlock Text="Active (5000 records/transaction)" FontSize="11" Foreground="White" Margin="3,0,0,8"/>

                                                <TextBlock Text="Activare Licență:" FontSize="9" FontWeight="Bold" Foreground="#9fa6b2" Margin="3,0,0,1"/>
                                                <TextBlock Text="Enterprise Server (Validă: 2027-12-31)" FontSize="11" Foreground="#10b981" Margin="3,0,0,12"/>
                                                
                                                <Border Height="1" Background="#232731" Margin="3,10"/>
                                                
                                                <TextBlock Text="Observații Investigație:" FontSize="10" Foreground="#9fa6b2" TextWrapping="Wrap" Margin="3"/>
                                                <TextBlock Text="- Paginarea la afișarea logurilor oferă un timp de răspuns sub 10ms." FontSize="10" Foreground="#9fa6b2" TextWrapping="Wrap" Margin="3,2"/>
                                                <TextBlock Text="- Jurnalizarea se face automat în format forensic valid." FontSize="10" Foreground="#9fa6b2" TextWrapping="Wrap" Margin="3,2"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 1: EVTX LOGS -->
                        <TabItem>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="380"/>
                                </Grid.ColumnDefinitions>

                                <!-- Table & Search -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Text="{Binding SearchEventsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Căutare după ID sau mesaj..."/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Data (UTC)" Binding="{Binding TimeCreated, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="135"/>
                                            <DataGridTextColumn Header="EID" Binding="{Binding EventId}" Width="55"/>
                                            <DataGridTextColumn Header="Nivel" Binding="{Binding Level}" Width="75"/>
                                            <DataGridTextColumn Header="Sursă" Binding="{Binding ProviderName}" Width="130"/>
                                            <DataGridTextColumn Header="Mașină" Binding="{Binding MachineName}" Width="100"/>
                                            <DataGridTextColumn Header="Mesaj" Binding="{Binding Message}" Width="*"/>
                                        </DataGrid.Columns>
                                        <DataGrid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenGenericDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        </DataGrid.InputBindings>
                                    </DataGrid>
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dimensiune pagină: 100 loguri" VerticalAlignment="Center" Foreground="DarkGray" FontSize="11"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="◀" Command="{Binding PrevEvtxPageCommand}" Width="40" Margin="2,0"/>
                                            <TextBlock Text="{Binding EvtxCurrentPage}" VerticalAlignment="Center" Foreground="White" Margin="8,0" FontWeight="Bold"/>
                                            <TextBlock Text=" / " VerticalAlignment="Center" Foreground="DarkGray"/>
                                            <TextBlock Text="{Binding EvtxTotalPages}" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                                            <Button Content="▶" Command="{Binding NextEvtxPageCommand}" Width="40" Margin="2,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#232731" Margin="8,0"/>

                                <!-- Right side details -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="120"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="DETALII EVENIMENT EVTX" FontSize="12" FontWeight="Bold" Foreground="#00adb5" Margin="0,0,0,10"/>
                                                <TextBlock Text="{Binding InspectorMachineName, StringFormat='Host: {0}'}" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding InspectorProviderName, StringFormat='Provider: {0}'}" FontSize="10" Foreground="DarkGray" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding InspectorTimeCreated, StringFormat='Timestamp: {0}'}" FontSize="10" Foreground="DarkGray" Margin="0,0,0,10"/>
                                                <Border Height="1" Background="#232731" Margin="0,0,0,10"/>
                                                <TextBox Text="{Binding InspectorMessage}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="11" AcceptsReturn="True"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                    <Border Grid.Row="1" Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="IOC-uri Identificate" FontSize="11" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,6"/>
                                            <ListBox Grid.Row="1" ItemsSource="{Binding CurrentIocs}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="10">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="{Binding Type}" FontWeight="Bold" Width="50" Foreground="#00adb5"/>
                                                            <TextBlock Text="{Binding Value}" Cursor="Hand" Foreground="#569CD6" TextDecorations="Underline">
                                                                <TextBlock.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotIocCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Value}"/>
                                                                </TextBlock.InputBindings>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: REGISTRY -->
                        <TabItem>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="380"/>
                                </Grid.ColumnDefinitions>

                                <!-- Table & Search -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Text="{Binding SearchArtifactsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Căutare după cheie sau valoare..."/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding RegistryArtifacts}" SelectedItem="{Binding SelectedArtifact}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Hive" Binding="{Binding HiveType}" Width="80"/>
                                            <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="120"/>
                                            <DataGridTextColumn Header="Cale Cheie" Binding="{Binding KeyPath}" Width="300"/>
                                            <DataGridTextColumn Header="Valoare" Binding="{Binding ValueName}" Width="130"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding ValueData}" Width="*"/>
                                        </DataGrid.Columns>
                                        <DataGrid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenGenericDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        </DataGrid.InputBindings>
                                    </DataGrid>
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dimensiune pagină: 100 loguri" VerticalAlignment="Center" Foreground="DarkGray" FontSize="11"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="◀" Command="{Binding PrevRegistryPageCommand}" Width="40" Margin="2,0"/>
                                            <TextBlock Text="{Binding RegistryCurrentPage}" VerticalAlignment="Center" Foreground="White" Margin="8,0" FontWeight="Bold"/>
                                            <TextBlock Text=" / " VerticalAlignment="Center" Foreground="DarkGray"/>
                                            <TextBlock Text="{Binding RegistryTotalPages}" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                                            <Button Content="▶" Command="{Binding NextRegistryPageCommand}" Width="40" Margin="2,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#232731" Margin="8,0"/>

                                <!-- Right side -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="120"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="DETALII ARTEFACT REGISTRU" FontSize="12" FontWeight="Bold" Foreground="#00adb5" Margin="0,0,0,10"/>
                                                <TextBlock Text="Sursa: Hive Offline" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding InspectorProviderName, StringFormat='Categorie: {0}'}" FontSize="10" Foreground="DarkGray" Margin="0,0,0,10"/>
                                                <Border Height="1" Background="#232731" Margin="0,0,0,10"/>
                                                <TextBox Text="{Binding InspectorMessage}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="11" AcceptsReturn="True"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                    <Border Grid.Row="1" Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="IOC-uri Identificate" FontSize="11" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,6"/>
                                            <ListBox Grid.Row="1" ItemsSource="{Binding CurrentIocs}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="10">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="1">
                                                            <TextBlock Text="{Binding Type}" FontWeight="Bold" Width="50" Foreground="#00adb5"/>
                                                            <TextBlock Text="{Binding Value}" Cursor="Hand" Foreground="#569CD6" TextDecorations="Underline">
                                                                <TextBlock.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotIocCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Value}"/>
                                                                </TextBlock.InputBindings>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: ALERTS -->
                        <TabItem>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="380"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Content="Ascunde alerte investigate (verificate)" IsChecked="{Binding HideVerifiedAlerts}" Foreground="White" Margin="5,0,0,10"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="80"/>
                                            <DataGridTextColumn Header="Alertă Corelată" Binding="{Binding Title}" Width="220"/>
                                            <DataGridTextColumn Header="Descriere Analiză &amp; TTPs" Binding="{Binding Explanation}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#232731" Margin="8,0"/>

                                <Border Grid.Column="2" Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="INSPECTOR ALERTE SECURITATE" FontSize="12" FontWeight="Bold" Foreground="#ef4444" Margin="0,0,0,10"/>
                                            <TextBlock Text="Sursa: Analiză Corelare" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding InspectorTimeCreated, StringFormat='Timestamp: {0}'}" FontSize="10" Foreground="DarkGray" Margin="0,0,0,10"/>
                                            <Border Height="1" Background="#232731" Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding InspectorMessage}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Segoe UI" FontSize="11" AcceptsReturn="True"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 4: TIMELINE -->
                        <TabItem>
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="380"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Text="{Binding SearchEventsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Căutare în Timeline..."/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding TimelineItems}" SelectedItem="{Binding SelectedTimelineItem}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="135"/>
                                            <DataGridTextColumn Header="Sursă" Binding="{Binding Source}" Width="80"/>
                                            <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="150"/>
                                            <DataGridTextColumn Header="Utilizator / Host" Binding="{Binding UserOrHost}" Width="120"/>
                                            <DataGridTextColumn Header="Mesaj Detaliat Eveniment" Binding="{Binding Description}" Width="*"/>
                                        </DataGrid.Columns>
                                        <DataGrid.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenGenericDetailCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        </DataGrid.InputBindings>
                                    </DataGrid>
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dimensiune pagină: 100 loguri" VerticalAlignment="Center" Foreground="DarkGray" FontSize="11"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="◀" Command="{Binding PrevTimelinePageCommand}" Width="40" Margin="2,0"/>
                                            <TextBlock Text="{Binding TimelineCurrentPage}" VerticalAlignment="Center" Foreground="White" Margin="8,0" FontWeight="Bold"/>
                                            <TextBlock Text=" / " VerticalAlignment="Center" Foreground="DarkGray"/>
                                            <TextBlock Text="{Binding TimelineTotalPages}" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                                            <Button Content="▶" Command="{Binding NextTimelinePageCommand}" Width="40" Margin="2,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#232731" Margin="8,0"/>

                                <Border Grid.Column="2" Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="INSPECTOR TIMELINE CRONOLOGIC" FontSize="12" FontWeight="Bold" Foreground="#00adb5" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding InspectorMachineName, StringFormat='Host / Utilizator: {0}'}" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding InspectorProviderName, StringFormat='Sursa: {0}'}" FontSize="10" Foreground="DarkGray" Margin="0,0,0,10"/>
                                            <Border Height="1" Background="#232731" Margin="0,0,0,10"/>
                                            <TextBox Text="{Binding InspectorMessage}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="11" AcceptsReturn="True"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- MODULE 1: AUDIT DATA COLLECTION -->
            <TabItem>
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Configuration panel -->
                        <ColumnDefinition Width="420"/>
                        <!-- Right: Live Console Terminal -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Configuration -->
                    <Border Grid.Column="0" Background="#11141a" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="20" Margin="0,0,20,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Configurare Colector Date Audit" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                                <TextBlock Text="TIP ECHIPAMENT DESTINAȚIE:" FontSize="9" FontWeight="Bold" Foreground="#9fa6b2" Margin="3,0,0,5"/>
                                <ComboBox ItemsSource="{Binding TargetTypes}" SelectedItem="{Binding SelectedTargetType}" Margin="0,0,0,15"/>

                                <TextBlock Text="IP / NUME GAZDĂ (HOSTNAME):" FontSize="9" FontWeight="Bold" Foreground="#9fa6b2" Margin="3,0,0,5"/>
                                <TextBox Text="{Binding CollectionHostname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                                <TextBlock Text="DIRECTOR RĂDĂCINĂ SALVARE (LOCAL):" FontSize="9" FontWeight="Bold" Foreground="#9fa6b2" Margin="3,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CollectionOutputDir, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" IsReadOnly="True"/>
                                    <Button Content="Alege..." Command="{Binding SelectCollectionOutputDirCommand}" Grid.Column="1" Margin="5,0,0,0" Width="80"/>
                                </Grid>
                                
                                <Border Height="1" Background="#232731" Margin="0,10,0,15"/>

                                <!-- Syslog settings (active when DataCenter selected) -->
                                <TextBlock Text="CONECTARE UNILATERALĂ (DATA CENTER - UDP SYSLOG):" FontSize="9" FontWeight="Bold" Foreground="#9fa6b2" Margin="3,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SyslogPort, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" ToolTip="Portul UDP de ascultare pentru primirea syslog stream."/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                        <Button Content="Start Syslog" Command="{Binding StartSyslogCommand}" IsEnabled="{Binding IsSyslogInactive}" Width="95"/>
                                        <Button Content="Stop" Command="{Binding StopSyslogCommand}" IsEnabled="{Binding IsSyslogActive}" Margin="3,0,0,0" Width="55"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Collector status info -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15">
                                <Border Background="#14171d" BorderBrush="#232731" BorderThickness="1" CornerRadius="2" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="STRUCTURA DE DENUMIRE AUDIT:" FontSize="10" FontWeight="Bold" Foreground="#00adb5" Margin="0,0,0,8"/>
                                        <TextBlock Text="Director Save:" FontSize="9" Foreground="#9fa6b2"/>
                                        <TextBlock Text="{Binding CollectionOutputDir, StringFormat='{}{0}\\[Luna-An]\\'}" FontSize="11" Foreground="White" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        
                                        <TextBlock Text="Nume Folder Echipament:" FontSize="9" Foreground="#9fa6b2"/>
                                        <TextBlock Text="{Binding SelectedTargetType, StringFormat='{}{}[Prefix]_{0}_[NumeHost]'}" FontSize="11" Foreground="White" Margin="0,0,0,8"/>

                                        <TextBlock Text="Nume Fișiere Colectate:" FontSize="9" Foreground="#9fa6b2"/>
                                        <TextBlock Text="[Prefix]_[NumeHost]_[NumeArtefact]_[Data].[ext]" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Large Actions -->
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <Button Content="Pornește Colectarea (Triage local/WinRM)" Command="{Binding StartCollectionCommand}" IsEnabled="{Binding IsCollectionNotRunning}" Height="40" Background="#1e2c3c" BorderBrush="#00adb5" Foreground="#00adb5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Console Log terminal -->
                    <Border Grid.Column="1" Background="#05070a" BorderBrush="#14171d" BorderThickness="1" CornerRadius="2" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCollectionRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#10b981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="JURNAL LIVE CONSOLĂ COLECTARE" FontSize="11" FontWeight="Bold" Foreground="#9fa6b2" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Grid.Row="1" Text="{Binding CollectionLogs}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#10b981" BorderThickness="0" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- GLOBAL STATUS BAR -->
        <Border Grid.Row="2" Background="#11141a" BorderThickness="0,1,0,0" BorderBrush="#232731" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#9fa6b2" FontWeight="Medium" VerticalAlignment="Center" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#10b981" Margin="0,0,6,0"/>
                    <TextBlock Text="SYSTEM SECURE OK" Foreground="#10b981" FontWeight="Bold" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GLOBAL LOADING OVERLAY -->
        <Grid Grid.RowSpan="3" Background="#d2000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#11141a" BorderBrush="#2c3545" BorderThickness="1" CornerRadius="2" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="#00adb5" Background="#1c2028" BorderThickness="0" Margin="0,0,0,20"/>
                    <TextBlock Text="Se procesează..." Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGray" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>