                                        <TextBlock Text="Corelarea tehnicilor MITRE identificate în sesiune cu bazele de cunoștințe privind actorii statali și de criminalitate cibernetică" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
