<Window x:Class="LogAnalyzer.UI.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activare Licență LogAnalyzer" Height="400" Width="550"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#0D1117" Foreground="#C9D1D9">
    <Border BorderBrush="#30363D" BorderThickness="1" Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🛡️ LogAnalyzer.MVP" FontSize="24" FontWeight="Bold" Foreground="#58A6FF" HorizontalAlignment="Center"/>
            <TextBlock Text="Sistem neînregistrat. Este necesară o licență validă." FontSize="14" Foreground="#F85149" HorizontalAlignment="Center" Margin="0,5,0,30"/>

            <TextBlock Text="ID HARDWARE MAȘINĂ (Copiază și trimite furnizorului):" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtHardwareId" Background="#010409" Foreground="#58A6FF" BorderBrush="#30363D" BorderThickness="1" Padding="10" FontSize="16" FontWeight="Bold" IsReadOnly="True" TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="INTRODU CHEIA DE LICENȚĂ (20 CARACTERE):" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLicenseKey" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#3B82F6" BorderThickness="1" Padding="10" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Activează Produsul" Width="180" Height="40" Background="#238636" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Activate_Click" Margin="0,0,15,0" Cursor="Hand"/>
                <Button Content="Ieșire" Width="100" Height="40" Background="#21262D" Foreground="#C9D1D9" FontWeight="Bold" BorderThickness="0" Click="Exit_Click" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>