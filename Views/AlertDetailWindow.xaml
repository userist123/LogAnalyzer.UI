<Window x:Class="LogAnalyzer.UI.Views.AlertDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Triage Alertă de Securitate" Height="480" Width="680"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#070812"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0c0f1c"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#111528"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1e2538"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#8b5cf6"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f5f7ff"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#a7adc2"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#ef4444"/>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y" From="15" To="0" Duration="0:0:0.25" DecelerationRatio="0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5" CornerRadius="10" Opacity="0">
        <Border.Effect>
            <DropShadowEffect Color="#8b5cf6" Direction="270" ShadowDepth="0" Opacity="0.35" BlurRadius="18"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="15"/>
        </Border.RenderTransform>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Background="#0c101d" MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0">
                    <TextBlock Text="🚨 DETALII ALERTĂ DE SECURITATE" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Width="38" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SeverityBadge" CornerRadius="4" Padding="8,4" Background="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="SeverityText" Text="HIGH" Foreground="White" FontWeight="Black" FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="TitleBlock" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,12">
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Mapare Tehnică MITRE:" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="MitreBlock" Text="T1110 (Brute Force)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Cadru Compliance / Normativ:" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="ComplianceBlock" Text="NIST SP 800-53" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="DESCRIERE EVENIMENT &amp; RECOMANDĂRI" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="1" x:Name="DetailsTextBox" IsReadOnly="True" TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" 
                                 FontFamily="Consolas" FontSize="12.5" BorderThickness="0" AcceptsReturn="True"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#0c101d" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" CornerRadius="0,0,10,10" Padding="14,0">
                <Grid>
                    <Button Content="Închide Panel" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,6" Background="Transparent" Foreground="White" BorderBrush="{StaticResource BorderBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>