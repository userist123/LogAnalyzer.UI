<Window x:Class="LogAnalyzer.UI.Views.AlertDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Triage Alertă de Securitate" Height="450" Width="650"
        WindowStartupLocation="CenterOwner" Background="#FF0F1219" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TitleBlock" FontSize="18" FontWeight="Bold" Foreground="#FFD69D36" Margin="0,0,0,15" TextWrapping="Wrap"/>
        
        <Border Grid.Row="1" Background="#FF161A22" BorderBrush="#FF30363D" BorderThickness="1" CornerRadius="6" Padding="15">
            <TextBox x:Name="DetailsTextBox" IsReadOnly="True" TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="White" 
                     FontFamily="Consolas" FontSize="13" BorderThickness="0" AcceptsReturn="True"/>
        </Border>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Închide Alertă" Click="Close_Click" Background="#FF333337" Foreground="White" Padding="15,8" Cursor="Hand" BorderBrush="#FF434346"/>
        </StackPanel>
    </Grid>
</Window>