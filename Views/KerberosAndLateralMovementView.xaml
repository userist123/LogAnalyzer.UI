<UserControl x:Class="LogAnalyzer.UI.Views.KerberosAndLateralMovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="ADAudit &amp; Active Directory Threat Intelligence" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Margin="12,0,0,0" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="ADAUDIT PLUS SUITE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Auditare completă utilizatori/grupuri privilegiate, modificări GPO, atacuri Kerberoasting (T1558.003), DCSync (T1003.006) și execuții LOLBAS" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. ADAudit Executive KPI Metrics Strip -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <!-- Metric 1: Total AD Events -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="EVENIMENTE AD AUDITATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding AdEventsAnalyzedCount, FallbackValue=0}" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                    <TextBlock Text="Jurnale Securitate &amp; DS (4720..4799)" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 2: Privileged Group Changes -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="MEMBRI GRUPURI PRIVILEGIATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="{Binding AdPrivilegedGroupChangesCount, FallbackValue=0}" FontSize="20" FontWeight="Black" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,2"/>
                    <TextBlock Text="Domain Admins / Enterprise Admins" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 3: Account Lockouts & Spraying -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="BLOCĂRI CONTURI / SPRAYING" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HighBrush}"/>
                    <TextBlock Text="{Binding AdAccountLockoutsCount, FallbackValue=0}" FontSize="20" FontWeight="Black" Foreground="{StaticResource HighBrush}" Margin="0,4,0,2"/>
                    <TextBlock Text="EID 4740 (Depășire prag parole)" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 4: GPO & Domain Policy Tampering -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="MODIFICĂRI POLITICI GPO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="{Binding AdGpoPolicyChangesCount, FallbackValue=0}" FontSize="20" FontWeight="Black" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,2"/>
                    <TextBlock Text="EID 4739 / 5136 (Password &amp; Lockout)" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 5: Kerberos & AD Exploits -->
            <Border Style="{StaticResource ObsidianCardStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="ATACURI AD &amp; KERBEROS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="{Binding AdKerberosAttacksCount, FallbackValue=0}" FontSize="20" FontWeight="Black" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,4,0,2"/>
                    <TextBlock Text="Kerberoasting, DCSync, Golden Ticket" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. Main 2-Pane Split: Left ADAudit & Kerberos Detections, Right LOLBAS Binaries -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: ADAudit & Kerberos Detections -->
            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Anomalii de Autentificare &amp; Modificări Active Directory" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding KerberosFindings.Count, StringFormat='{}{0} Detecții'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding KerberosFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="Tip Atac / Eveniment" Binding="{Binding AttackType}" Width="160"/>
                            <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="85"/>
                            <DataGridTextColumn Header="Cont Țintă" Binding="{Binding TargetAccount}" Width="130"/>
                            <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="80"/>
                            <DataGridTextColumn Header="Sursă / IP" Binding="{Binding ClientIp}" Width="95"/>
                            <DataGridTextColumn Header="Sumar Analiză &amp; Recomandare Răspuns" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: LOLBAS Execution Audit -->
            <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Audit Execuții Living-off-the-Land (LOLBAS Binaries)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HighBrush}"/>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding LolbasFindings.Count, StringFormat='{}{0} Detecții'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding LolbasFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Binar LOLBAS" Binding="{Binding BinaryName}" Width="100"/>
                            <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="80"/>
                            <DataGridTextColumn Header="Categorie Execuție" Binding="{Binding Category}" Width="125"/>
                            <DataGridTextColumn Header="Linie de Comandă Detectată" Binding="{Binding CommandLine}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
