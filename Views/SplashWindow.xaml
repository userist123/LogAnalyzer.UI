<Window x:Class="LogAnalyzer.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Încărcare SOC..." Height="300" Width="500"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#0D1117" AllowsTransparency="True">
    <Border BorderBrush="#30363D" BorderThickness="2" CornerRadius="10" Padding="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🛡️ LogAnalyzer.MVP" FontSize="28" FontWeight="Bold" Foreground="#58A6FF" HorizontalAlignment="Center"/>
            <TextBlock Text="SOC Command Center - Offline DFIR" FontSize="14" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,5,0,30"/>
            
            <ProgressBar x:Name="ProgBar" Width="300" Height="8" IsIndeterminate="True" Foreground="#238636" Background="#161B22" BorderThickness="0"/>
            <TextBlock x:Name="TxtStatus" Text="Se inițializează motorul de analiză și baza de cunoștințe (HG 585/2002)..." FontSize="11" Foreground="#C9D1D9" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
    </Border>
</Window>