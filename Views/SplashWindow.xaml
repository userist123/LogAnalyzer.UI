<Window x:Class="LogAnalyzer.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Încărcare SOC..." Height="300" Width="500"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True">
    <Border Background="#080C14" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="10" Padding="24">
        <Border.Effect>
            <DropShadowEffect Color="#7C3AED" Direction="270" ShadowDepth="0" Opacity="0.35" BlurRadius="20"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="🛡️ LOGANALYZER" FontSize="24" FontWeight="Black" Foreground="White"/>
                <TextBlock Text=" COMMAND CENTER" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
            </StackPanel>
            <TextBlock Text="Enterprise Threat Triage &amp; Incident Response" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,26"/>
            
            <ProgressBar x:Name="ProgBar" Width="340" Height="6" IsIndeterminate="True" Foreground="#7C3AED" Background="#121A2D" BorderThickness="0"/>
            <TextBlock x:Name="TxtStatus" Text="Se inițializează motorul de analiză și baza de cunoștințe (HG 585/2002)..." FontSize="11" Foreground="#22D3EE" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </Border>
</Window>